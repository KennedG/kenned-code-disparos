{
  "name": "automacao-comunidade",
  "version": "1.0.0",
  "description": "Convites autorizados e organizados para comunidades pelo WhatsApp",
  "main": "src/main.cjs",
  "author": "Kenned Code",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node scripts/test.cjs",
    "test:ui": "node scripts/smoke-ui.cjs",
    "check": "node scripts/check.cjs",
    "dist:win": "node scripts/build-win.cjs"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "pino": "9.14.0",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "br.com.kennedcode.automacaocomunidade",
    "productName": "Automação Comunidade",
    "compression": "maximum",
    "publish": [],
    "asar": true,
    "afterPack": "scripts/ownership-manifest.cjs",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "docs/**/*",
      "README.md",
      "LICENSE"
    ],
    "asarUnpack": [
      "node_modules/whatsapp-rust-bridge/**/*",
      "node_modules/@whiskeysockets/baileys/node_modules/whatsapp-rust-bridge/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico",
      "signExecutable": false,
      "artifactName": "Automacao-Comunidade-Setup-1.0.0-${arch}.exe"
    },
    "nsis": {
      "script": "scripts/installer.nsi",
      "differentialPackage": false,
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Automação Comunidade",
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "pt_BR"
      ],
      "language": "1046"
    },
    "electronLanguages": [
      "pt-BR",
      "en-US"
    ]
  }
}
